# ---------------------------------------------------------------------------
# Hardhat / smart-contract environment.
# Copy this file to `.env` and fill it in. `.env` is git-ignored — never commit it.
# The backend and frontend have their own .env.example files.
# ---------------------------------------------------------------------------

# JSON-RPC endpoint used for testnet deployments.
# A blockchain node you send requests to — the rough equivalent of a database
# connection string. Get a free one from Alchemy or Infura.
SEPOLIA_RPC_URL=

# Private key of the account that deploys the contract and becomes its first admin.
# This key controls real funds on mainnet. Use a throwaway account for testnets,
# and NEVER commit a real key or paste one into the frontend.
DEPLOYER_PRIVATE_KEY=

# Used by `hardhat verify` to publish the source code on Etherscan, so anyone
# can read the contract you deployed instead of trusting raw bytecode.
ETHERSCAN_API_KEY=

# Set to "true" to print a gas-usage report when running tests.
REPORT_GAS=false
