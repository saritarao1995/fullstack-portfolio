# ---------------------------------------------------------------------------
# Frontend environment. Copy to `frontend/.env`.
# Vite only exposes variables prefixed with VITE_ to browser code.
# Anything in here ships to the browser and is PUBLIC — never put a private
# key or a secret in this file.
# ---------------------------------------------------------------------------

# Chain the dApp asks MetaMask to switch to (31337 = local Hardhat node,
# 11155111 = Sepolia testnet).
VITE_DEFAULT_CHAIN_ID=31337

# Deployed CertificateVerification contract address. When left empty the app
# falls back to src/contracts/addresses.json, which the deploy script writes
# automatically after a successful deployment.
VITE_CONTRACT_ADDRESS=

# Base URL of the Express backend used for metadata, auth and PDF links.
# Public certificate verification does not depend on this.
VITE_API_BASE_URL=http://localhost:4000/api
