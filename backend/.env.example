# Copy to backend/.env. Never commit the real file.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB or an Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/certchain

# Used to sign admin JWTs. Change this before any shared/testnet use.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Seeded on first boot if no admin exists.
ADMIN_NAME=Institute Admin
ADMIN_EMAIL=admin@certchain.local
ADMIN_PASSWORD=Admin@12345
ADMIN_WALLET=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
